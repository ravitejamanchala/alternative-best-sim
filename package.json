{
  "name": "slaydrive-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:browser": "node --import tsx tests/browser.ts",
    "sample": "node --import tsx scripts/sample.ts",
    "bench": "node --import tsx scripts/benchmark.ts",
    "api:dev": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=/tmp/slaydrive-world-wrangler.log wrangler dev",
    "api:check": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=/tmp/slaydrive-world-wrangler.log wrangler deploy --dry-run --outdir /tmp/slaydrive-world-worker",
    "build:adapter": "vite build --config vite.library.ts",
    "test:physics": "node --import tsx tests/physics-browser.ts",
    "format": "prettier --write src server tests scripts *.ts *.json *.md docs/*.md",
    "test:interaction": "STUDIO_URL=http://127.0.0.1:5173 node --import tsx tests/interaction-browser.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "learner:preview": "node --import tsx scripts/learner-preview.ts",
    "test:learner": "node --import tsx tests/learner-browser.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.23.2",
    "@clerk/react": "6.18.3",
    "@fontsource/dm-sans": "5.2.8",
    "@fontsource/manrope": "5.2.8",
    "@neondatabase/serverless": "1.0.2",
    "clipper-lib": "6.4.2",
    "drizzle-orm": "0.44.7",
    "hono": "4.11.7",
    "lucide-react": "0.468.0",
    "polygon-clipping": "0.15.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "0.128.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/clipper-lib": "6.4.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.128.0",
    "@vitejs/plugin-react": "5.1.1",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "wrangler": "4.50.0"
  }
}
